{
  "name": "htmlcraft",
  "version": "0.1.1",
  "description": "Visual editor, CLI, and MCP server for self-contained HTML presentations",
  "license": "MIT",
  "author": "htmlcraft contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HappyLiang12/htmlcraft.git"
  },
  "homepage": "https://github.com/HappyLiang12/htmlcraft#readme",
  "bugs": {
    "url": "https://github.com/HappyLiang12/htmlcraft/issues"
  },
  "keywords": [
    "presentation",
    "slides",
    "html",
    "mcp",
    "cli",
    "editor",
    "deck",
    "agent"
  ],
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "htmlcraft": "dist/cli.js",
    "htmlcraft-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD-PARTY-LICENSES.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs && node ../../scripts/generate-third-party-licenses.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
